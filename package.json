{
  "name": "taskcontrol",
  "version": "1.0.0",
  "private": true,
  "description": "Controle de tarefas com entrega de arquivos e revisao por IA",
  "type": "module",
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c cyan,magenta \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "npm run dev --workspace server",
    "dev:client": "npm run dev --workspace client",
    "build": "npm run build --workspace client",
    "start": "npm run build && npm run start --workspace server",
    "test": "npm run test --workspace server",
    "build:demo": "npm run build:demo --workspace client"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
